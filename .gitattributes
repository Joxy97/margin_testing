# Raw benchmark bytes must survive Windows/Linux Git checkout unchanged.
benchmark_data/** -text -diff
*.npz binary

# Preserve the deployed code/configuration identities across Git platforms.
*.py -text
configs/*.json -text
# Preserve checksum-bound JSON bytes, including original CRLF terminators.
fine_tuning/*.json -text whitespace=cr-at-eol
fine_tuning/solvers/*.json -text whitespace=cr-at-eol
